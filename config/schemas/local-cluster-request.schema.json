{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bhighnam/cluster-provisioning-pipeline/config/schemas/local-cluster-request.schema.json",
  "title": "LocalClusterRequest",
  "description": "Request to provision a local/on-prem Kubernetes cluster with Kubespray + Longhorn.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster_name", "node_ips"],
  "properties": {
    "cluster_name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "minLength": 2,
      "maxLength": 63,
      "description": "DNS-1123 label used for inventory dir and workflow naming."
    },
    "node_ips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "SSH-reachable node IPs for Kubespray (control-plane first)."
    },
    "ssh_user": {
      "type": "string",
      "default": "ubuntu"
    },
    "kubespray_version": {
      "type": "string",
      "default": "v2.26.0"
    },
    "longhorn_version": {
      "type": "string",
      "default": "1.7.2"
    },
    "dry_run": {
      "type": "boolean",
      "default": true,
      "description": "When true, validate and print actions without running ansible/helm."
    }
  }
}
